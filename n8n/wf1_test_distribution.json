        "id": "49cb1185-2fc2-4ce8-a9df-6c9bdd6b17f3",
        "name": "Запись сессии",
        "retryOnFail": true,
        "maxTries": 5,
        "waitBetweenTries": 15000,
        "credentials": {
          "googleApi": {
            "id": "{{N8N_GOOGLE_CRED_ID}}",
            "name": "Google Service Account account"
          }
