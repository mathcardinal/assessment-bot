      {
        "parameters": {
          "jsCode": "const employee = $('Текущий сотрудник').first().json;\nconst value = $input.first().json.propertyName;\n\nif (value) {\n  const normalized = value.replace(/^=/, '');\n  if (normalized.startsWith('завершён:')) {\n    const completedSessionId = normalized.replace('завершён:', '');\n    const newSessionId = `${employee.employee_id}_${employee.целевая_аудитория}_${employee.цикл}_${employee.номер_теста}_1`;\n    if (completedSessionId === newSessionId) {\n      return [{ json: { ...employee, has_session: true } }];\n    }\n  } else {\n    return [{ json: { ...employee, has_session: true } }];\n  }\n}\n\nlet suspended = false;\ntry {\n  const user = await this.helpers.httpRequest({\n    method: 'GET',\n    url: 'https://api.pachca.com/api/shared/v1/users/' + Number(employee.pachca_user_id),\n    headers: { 'Authorization': 'Bearer ' + $env.PACHCA_TOKEN }\n  });\n  suspended = user.data.suspended === true;\n} catch (e) {\n  suspended = false;\n}\n\nif (suspended) {\n  return [{ json: { ...employee, has_session: true, pachca_suspended: true } }];\n}\n\nreturn [{ json: { ...employee, has_session: false } }];"
        },
