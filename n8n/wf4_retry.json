      {
        "parameters": {
          "jsCode": "const allQuestions = $('Банк вопросов').all();\nconst история = $('История сессий').all().map(x => x.json);\nconst employee = $('Проверка активной сессии').first().json;\n\nconst датаЧисло = (v) => {\n  if (!v) return 0;\n  const s = String(v).trim();\n  const m = s.match(/^(\\d{2})\\.(\\d{2})\\.(\\d{4})(?:,?\\s+(\\d{1,2}):(\\d{2})(?::(\\d{2}))?)?/);\n  if (m) return Date.UTC(+m[3], +m[2] - 1, +m[1], +(m[4] || 0), +(m[5] || 0), +(m[6] || 0));\n  const t = Date.parse(s);\n  return Number.isNaN(t) ? 0 : t;\n};\n\nconst перемешать = (arr) => {\n  const a = arr.slice();\n  for (let i = a.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [a[i], a[j]] = [a[j], a[i]];\n  }\n  return a;\n};\n\nconst верные = (raw) => String(raw ?? '')\n  .split(',')\n  .map(s => s.trim().toUpperCase())\n  .filter(s => ['A', 'B', 'C', 'D'].includes(s));\n\nconst filtered = allQuestions.filter(q => {\n  const roles = q.json.целевая_аудитория ? q.json.целевая_аудитория.split(',').map(r => r.trim()) : [];\n  const активен = q.json.активен !== 'нет';\n  const активенС = q.json.активен_с ? датаЧисло(q.json.активен_с) <= Date.now() : true;\n  return roles.includes(employee.целевая_аудитория) && активен && активенС;\n});\n\nif (filtered.length < 10) {\n  return [{ json: { skip: true, employee_id: employee.employee_id } }];\n}\n\nconst мои = история.filter(s => String(s.employee_id) === String(employee.employee_id));\n\nconst виден = {};\nfor (const s of мои) {\n  const когда = датаЧисло(s.sent_at);\n  for (const qid of String(s.question_ids || '').split(',').map(x => x.trim()).filter(Boolean)) {\n    if (!(qid in виден) || когда > виден[qid]) виден[qid] = когда;\n  }\n}\n\nconst перваяПопытка = мои\n  .filter(s => String(s.цикл) === String(employee.цикл)\n    && String(s.номер_теста) === String(employee.номер_теста)\n    && String(s.номер_попытки) === '1')\n  .sort((a, b) => датаЧисло(b.sent_at) - датаЧисло(a.sent_at))[0];\n\nconst поId = {};\nfor (const q of filtered) поId[q.json.question_id] = q;\n\nconst завалено = [];\nif (перваяПопытка) {\n  let ответы = {};\n  try { ответы = JSON.parse(перваяПопытка.answers || '{}'); } catch (e) { ответы = {}; }\n  for (const qid of String(перваяПопытка.question_ids || '').split(',').map(x => x.trim()).filter(Boolean)) {\n    if (!поId[qid]) continue;\n    const ответ = String(ответы[qid] ?? '').trim().toUpperCase();\n    const верно = ответ && верные(поId[qid].json.правильный_ответ).includes(ответ);\n    if (!верно) завалено.push(поId[qid]);\n  }\n}\n\nconst взято = new Set(завалено.map(q => q.json.question_id));\nconst остальные = filtered.filter(q => !взято.has(q.json.question_id));\n\nconst поПартиям = {};\nfor (const q of остальные) {\n  if (q.json.question_id in виден) continue;\n  const ключ = датаЧисло(q.json.активен_с);\n  if (!поПартиям[ключ]) поПартиям[ключ] = [];\n  поПартиям[ключ].push(q);\n}\n\nconst свежие = [];\nfor (const партия of Object.keys(поПартиям).map(Number).sort((a, b) => b - a)) {\n  свежие.push(...перемешать(поПартиям[партия]));\n}\n\nconst давние = остальные\n  .filter(q => q.json.question_id in виден)\n  .map(q => [виден[q.json.question_id], q])\n  .sort((a, b) => a[0] - b[0])\n  .map(x => x[1]);\n\nconst selected = [...завалено, ...свежие, ...давние].slice(0, 10);\nconst questionIds = selected.map(q => q.json.question_id).join(',');\n\nconst questionsData = {};\nselected.forEach(q => {\n  questionsData[q.json.question_id] = {\n    текст_вопроса: q.json.текст_вопроса,\n    вариант_A: q.json.вариант_A,\n    вариант_B: q.json.вариант_B,\n    вариант_C: q.json.вариант_C,\n    вариант_D: q.json.вариант_D,\n    правильный_ответ: q.json.правильный_ответ,\n    вес_баллов: q.json.вес_баллов,\n    инструкция_БЗ: q.json.инструкция_БЗ\n  };\n});\n\nconst sessionId = `${employee.employee_id}_${employee.целевая_аудитория}_${employee.цикл}_${employee.номер_теста}_2`;\n\nconst session = {\n  session_id: sessionId,\n  employee_id: employee.employee_id,\n  pachca_user_id: Number(employee.pachca_user_id),\n  ФИО: employee.ФИО,\n  целевая_аудитория: employee.целевая_аудитория,\n  цикл: employee.цикл,\n  номер_теста: employee.номер_теста,\n  номер_попытки: 2,\n  attempt_id: $('Проверка активной сессии').first().json.attempt_id,\n  никнейм: employee.никнейм,\n  никнейм_руководителя: employee.никнейм_руководителя,\n  question_ids: questionIds,\n  questions_data: JSON.stringify(questionsData),\n  current_question_index: 0,\n  total_questions: 10,\n  answers: '{}',\n  sent_at: new Date().toISOString(),\n  reminder_count: 0,\n  total_score: 0,\n  max_score: 0,\n  статус: 'назначен',\n  row_number: employee.row_number\n};\n\nreturn [{ json: session }];"
        },
